<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:label="TextFlow"
        android:supportsRtl="true"
        android:theme="@style/Theme.TextFlow"
        tools:targetApi="34">
        
        <!-- Главный экран -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Экран чтения TXT и FB2 -->
        <activity
            android:name=".ReaderActivity"
            android:exported="true"
            android:theme="@style/Theme.TextFlow">
            
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
            </intent-filter>
            
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-fictionbook+xml" />
                <data android:scheme="file" android:mimeType="application/x-fictionbook+xml" />
                <data android:scheme="content" android:pathPattern=".*\\.fb2" />
                <data android:scheme="file" android:pathPattern=".*\\.fb2" />
            </intent-filter>
        </activity>

        <!-- Экран чтения EPUB (Readium) -->
        <activity
            android:name=".EpubReaderActivity"
            android:exported="true"
            android:theme="@style/Theme.TextFlow">
            
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:pathPattern=".*\\.epub" />
            </intent-filter>
        </activity>
            
    </application>
</manifest>
